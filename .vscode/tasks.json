{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NPM Install",
            "type": "shell",
            "command": "npm i",
        },
        {
            "label": "Init dist",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Create dist",
            ],
            "command": "Remove-Item",
            "type": "shell",
            "args": [
                "dist/*",
                "-Recurse",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Create dist",
            "type": "shell",
            "command": "New-Item",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "args": [
                "-ItemType",
                "Directory",
                "-Force",
                "-Path",
                "dist"
            ],
            "hide": true,
        },
        {
            "label": "Build Typescript",
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$tsc"
            ],
        },
        {
            "label": "Build LESS",
            "command": "LessBuilder",
            "type": "shell",
            "args": [
                "-c",
                "lessconfig.json",
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
        {
            "label": "Copy Modules",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "modules/**/*.js",
                "-Destination",
                "dist",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Copy Index",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "index.html,",
                "img/favicon.svg,",
                "img/favicon.png,",
                "img/favicon.ico,",
                "manifest.json",
                "-Destination",
                "dist",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Build Data",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build typescript Data",
                "Copy json Data",
                "Delete tsconfig from Data"
            ],
        },
        {
            "label": "Build typescript Data",
            "type": "typescript",
            "tsconfig": "data/tsconfig.json",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$tsc"
            ],
        },
        {
            "label": "Copy json Data",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "data",
                "-Filter",
                "*.json",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Delete tsconfig from Data",
            "command": "Remove-Item",
            "type": "shell",
            "args": [
                "-Path",
                "dist/data/tsconfig.json",
            ],
            "hide": true,
        },
        {
            "label": "Copy Fonts",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "fonts",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy Images",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "img,node_modules\\@peach\\ui\\img,node_modules\\@peach\\ui.components\\img",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy Maps",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "maps",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy Tales",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "tales",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Generate Version",
            "command": "GenVersion -o dist/manifest.json -t manifest.json",
            "type": "shell",
            "hide": true,
        },
        {
            "label": "Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Init dist",
                "Build Typescript",
                "Build LESS",
                "Copy Modules",
                "Copy Index",
                "Build Data",
                "Copy Fonts",
                "Copy Images",
                "Copy Maps",
                "Copy Tales",
                "Generate Version",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Init publish",
            "dependsOn": [
                "Create publish",
            ],
            "command": "Remove-Item",
            "type": "shell",
            "args": [
                "publish/*",
                "-Recurse",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Create publish",
            "type": "shell",
            "command": "New-Item",
            "args": [
                "-ItemType",
                "Directory",
                "-Force",
                "-Path",
                "publish"
            ],
            "hide": true,
        },
        {
            "label": "Zip publish",
            "type": "shell",
            "command": "Compress-Archive",
            "args": [
                "-Path",
                "dist/*",
                "-DestinationPath",
                "publish/web.zip"
            ],
            "hide": true,
        },
        {
            "label": "Publish",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Init publish",
                "Zip publish"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
    ]
}